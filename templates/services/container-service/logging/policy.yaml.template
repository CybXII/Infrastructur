version: 1
service: {{SERVICE_NAME}}

container:
  stdout: true
  stderr: true
  application_log_files: false
  driver: local
  inherit_daemon_logging: true
  service_logging_override_allowed: false
  rotation:
    max_size: 20m
    max_files: 5
    compress: true

central_retention:
  default_class: standard
  classes:
    debug_days: 7
    standard_days: 30
    error_days: 90
    security_days: 365
    audit_days: 365
    deployment_backup_days: 365

requirements:
  - Secrets und personenbezogene Daten dürfen nicht geloggt werden.
  - Production-Debuglogging ist standardmäßig deaktiviert.
  - Der Service darf die hostweite Docker-Logbegrenzung nicht umgehen.
  - Ein Ausfall der zentralen Logweiterleitung darf die Anwendung nicht unbegrenzt blockieren.
