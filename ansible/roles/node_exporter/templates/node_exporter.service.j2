# Managed by Ansible - do not edit manually
[Unit]
Description=Prometheus Node Exporter
Documentation=https://github.com/prometheus/node_exporter
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
ConditionPathExists={{ node_exporter_binary_path }}

[Service]
Type=simple
User={{ node_exporter_user }}
Group={{ node_exporter_group }}
ExecStart={{ node_exporter_binary_path }} \
  --web.listen-address={{ node_exporter_listen_address }} \
{% if not node_exporter_netdev_use_netlink %}
  --no-collector.netdev.netlink \
{% endif %}
  --collector.textfile.directory={{ node_exporter_textfile_directory }} \
  --collector.filesystem.mount-points-exclude={{ node_exporter_filesystem_mount_points_exclude }} \
  --collector.filesystem.fs-types-exclude={{ node_exporter_filesystem_fs_types_exclude }}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths={{ node_exporter_textfile_directory }}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow={{ node_exporter_monitoring_subnet }}
CPUQuota={{ node_exporter_cpu_quota }}
MemoryMax={{ node_exporter_memory_max }}
TasksMax={{ node_exporter_tasks_max }}
UMask=0027

[Install]
WantedBy=multi-user.target
