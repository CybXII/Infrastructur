  "failure_modes": [
    {
      "id": "backend-not-ready",
      "expected_behavior": "Traefik removes the backend from routing and admits it again after recovery.",
      "evidence": "platform/traefik/tests/test-routing.sh"
    },
    {
      "id": "acme-renewal-error",
      "expected_behavior": "The ACME error detector returns a failing signal.",
      "evidence": "platform/traefik/tests/test-routing.sh"
    },
    {
      "id": "network-isolation-drift",
      "expected_behavior": "Unexpected Docker network membership or non-internal app/data networks fail validation.",
      "evidence": "platform/traefik/tests/test-routing.sh"
    },
    {
      "id": "container-memory-exhaustion",
      "expected_behavior": "Memory pressure is contained by cgroups and ends with container-local OOMKilled=true while Docker remains reachable.",
      "evidence": "tests/integration/test-resource-limits.sh"
    },
    {
      "id": "container-pid-exhaustion",
      "expected_behavior": "New processes are rejected at the PID cgroup limit instead of exhausting the host.",
      "evidence": "tests/integration/test-resource-limits.sh"
    },
    {
      "id": "log-flood",
      "expected_behavior": "Old local container logs are rotated out while the newest logs remain available.",
      "evidence": "tests/integration/test-log-rotation.sh"
    },
    {
      "id": "failed-release",
      "expected_behavior": "A failed digest update is rolled back to the last known good digest and the deployment remains failed.",
      "evidence": "tests/integration/test-update-rollback.sh"
    },
    {
      "id": "container-recreate",
      "expected_behavior": "Persistent bind-mounted data survives replacement of the application container.",
      "evidence": "tests/integration/test-reference-service-deployment.sh"
    },
    {
      "id": "secret-path-traversal",
      "expected_behavior": "Invalid secret names and unsafe target paths are rejected.",
      "evidence": "tests/security/test-secret-management.sh"
    },
    {
      "id": "cleanup-unstable-release-state",
      "expected_behavior": "Apply is skipped while the latest deployment state is not verified stable.",
      "evidence": "tests/integration/test-docker-retention-cleanup.sh"
    },
    {
      "id": "cleanup-rollback-artifact-protection",
      "expected_behavior": "Current and previous known-good release images remain available while eligible old artifacts are removed.",
      "evidence": "tests/integration/test-docker-retention-cleanup.sh"
    }
  ],
