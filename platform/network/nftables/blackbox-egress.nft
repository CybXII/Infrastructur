# DRAFT ONLY - issue #95. DO NOT APPLY until host integration and nft syntax
# are validated on the exact AlmaLinux/Rocky + firewalld + Docker version.
# This table is scoped to Blackbox-owned IPs/interfaces, not the VPS as a whole.
#
# Fail-closed for traffic forwarded via the probe bridge. IPv6 is dropped on
# this bridge, but this policy must be validated against actual Docker IPv6
# settings. The Docker embedded DNS resolver (127.0.0.11) stays container-local.
# Its daemon-side DNS traffic is OUTSIDE this table's source-IP filtering.
# The monitoring bridge and same-bridge traffic require separate verification.
table inet mf_blackbox_probe {
  set blocked_ipv4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10,
      127.0.0.0/8, 169.254.0.0/16,
      172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
      192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
      198.51.100.0/24, 203.0.113.0/24,
      224.0.0.0/4, 240.0.0.0/4
    }
  }

  chain probe_forward {
    type filter hook forward priority -180; policy accept;
    # Do not initiate connections from Blackbox into the shared monitoring
    # segment. Replies to the Prometheus scrape are not new connections.
    iifname "mf-monitoring0" ip saddr 172.30.250.40 ct state new drop
    # The Blackbox probe interface may only establish TCP 443 sessions to
    # destinations outside the denied ranges. Reject everything else.
    iifname "mf-probe-egress" ip saddr 172.30.252.2 ip daddr @blocked_ipv4 drop
    # Only the pinned Blackbox source IP may initiate traffic on probe egress.
    iifname "mf-probe-egress" ip saddr != 172.30.252.2 drop
    iifname "mf-probe-egress" meta nfproto ipv6 drop
    iifname "mf-probe-egress" ip saddr 172.30.252.2 ct state established,related return
    iifname "mf-probe-egress" ip saddr 172.30.252.2 ct state new tcp dport 443 return
    iifname "mf-probe-egress" ip saddr 172.30.252.2 drop
  }

  chain probe_input {
    type filter hook input priority -180; policy accept;
    # Never allow Blackbox to start new connections to the Docker host.
    iifname "mf-probe-egress" ct state new drop
    iifname "mf-monitoring0" ip saddr 172.30.250.40 ct state new drop
  }
}
