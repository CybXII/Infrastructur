version: 1
service: example-service

secrets:
  - id: api-token
    purpose: Authentifizierung gegenüber einem externen Dienst
    runtime_target: /run/secrets/api-token
    source_class: deployment-or-recovery-vault
    owner_role: application-owner
    rotation:
      interval: provider-policy
      on_incident: immediate
    recovery_required: true
    service_restart_required: true

  - id: database-password
    purpose: Authentifizierung des Services an der Datenbank
    runtime_target: /run/secrets/database-password
    source_class: deployment-or-recovery-vault
    owner_role: infrastructure-owner
    rotation:
      interval: provider-policy
      on_incident: immediate
    recovery_required: true
    service_restart_required: true
